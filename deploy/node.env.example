# Settings for one SmartNodes VPN node, read by smartnode@NAME.service.
# Copy to /etc/smartnode/NAME.env, fill in the values marked CHANGE, then
# sudo chmod 600 /etc/smartnode/NAME.env
#
# Every option is explained by: smartnode -h
#
# An ENTRY node offering the disguise on port 443. For an EXIT node, remove the
# three -reality options. For a BRIDGE, see the bridge steps in the guide.
NODE_FLAGS="-key-file /etc/smartnode/node.key -node-id CHANGE -chain-id CHANGE -listen 0.0.0.0:51820 -iface sn0 -subnet 10.77.0.0/24 -session 1h -from nodeservice -keyring-backend test -home /etc/smartnode/keys -rpc tcp://CHANGE:26657 -reality-port 443 -xray /usr/local/bin/xray -reality-dir /var/lib/smartnode"
