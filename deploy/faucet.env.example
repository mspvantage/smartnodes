# Settings for smartfaucet.service. Fill in CHANGE, then chmod 600 this file.
# -trust-proxy only when an HTTPS proxy is in front of it.
FAUCET_FLAGS="-listen 127.0.0.1:8090 -amount 100000000usnode -period 24h -daily-cap 500 -trust-proxy -from faucet -keyring-backend test -home /home/smartnodes/.smartnodes -chain-id CHANGE -rpc tcp://localhost:26657"
