# Settings for smartissuer.service. Fill in CHANGE, then chmod 600 this file.
# The issuer key file must be readable by the smartnodes user only (mode 0600).
ISSUER_FLAGS="-issuer /home/smartnodes/issuer.json -key-id 0 -from issuer -keyring-backend test -home /home/smartnodes/.smartnodes -chain-id CHANGE -rpc tcp://localhost:26657"
