# Settings for the prober, read by smartprobe.service. Fill in CHANGE, then
# sudo chmod 600 /etc/smartnode/probe.env
PROBE_FLAGS="-from prober -keyring-backend test -home /etc/smartnode/keys -wallet /etc/smartnode/prober-wallet.json -chain-id CHANGE -rpc tcp://CHANGE:26657 -xray /usr/local/bin/xray"
