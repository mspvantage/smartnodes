# A SmartNodes prober. Runs as root: each probe gets its own network space.
#
# Install: sudo cp smartprobe.service /etc/systemd/system/
#          sudo cp probe.env.example /etc/smartnode/probe.env   (then edit it)
#          sudo systemctl daemon-reload && sudo systemctl enable --now smartprobe
[Unit]
Description=SmartNodes prober
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/smartnode/probe.env
ExecStart=/usr/local/bin/smartprobe run $PROBE_FLAGS
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
