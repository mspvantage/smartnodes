index 0000000..ba3c4cc
--- /dev/null
+++ b/x/verify/keeper/prober_test.go
@@ -0,0 +1,312 @@
+package keeper_test
+
+import (
+	"testing"
+	"time"
+
+	sdkerrors "github.com/cosmos/cosmos-sdk/types/errors"
+	"github.com/stretchr/testify/require"
+
+	"github.com/mspvantage/smartnodes/x/verify/types"
+)
+
+var (
+	minBond   = types.DefaultMinProberBond
+	unbonding = time.Duration(types.DefaultUnbondingSeconds) * time.Second
+)
+
+func TestRegisterProber(t *testing.T) {
+	f := initFixture(t)
+	addr, str := f.account(t, 1)
+	f.fund(addr, minBond+500)
+
+	res, err := f.ms.RegisterProber(f.ctx, &types.MsgRegisterProber{Owner: str, Bond: minBond})
+	require.NoError(t, err)
+
+	p := f.prober(t, res.Id)
+	require.Equal(t, str, p.Owner)
+	require.Equal(t, minBond, p.Bond)
+	require.Equal(t, types.ProberPending, p.Status)
+	require.Zero(t, p.UnbondingEnd)
+
+	// The bond left the owner's account and sits in the module account.
+	requireInt(t, 500, f.balance(addr))
+	requireInt(t, minBond, f.moduleBalance())
+	f.requireBondsExact(t)
+
+	// The owner index and the waiting list were filled in.
+	id, err := f.keeper.ProberByOwner.Get(f.ctx, str)
+	require.NoError(t, err)
+	require.Equal(t, res.Id, id)
+	waiting, err := f.keeper.PendingJoin.Has(f.ctx, res.Id)
+	require.NoError(t, err)
+	require.True(t, waiting)
+	require.True(t, f.hasEvent("verify_register_prober"))
+
+	// Ids count up.
+	second := f.newProber(t, 2)
+	require.Equal(t, res.Id+1, second.id)
+	f.requireBondsExact(t)
+}
+
+func TestRegisterProberRejected(t *testing.T) {
+	f := initFixture(t)
+	addr, str := f.account(t, 1)
+	f.fund(addr, minBond*3)
+
+	t.Run("invalid address", func(t *testing.T) {
+		_, err := f.ms.RegisterProber(f.scratch(), &types.MsgRegisterProber{Owner: "not-an-address", Bond: minBond})
+		require.Error(t, err)
+	})
+	t.Run("bond below the minimum", func(t *testing.T) {
+		_, err := f.ms.RegisterProber(f.scratch(), &types.MsgRegisterProber{Owner: str, Bond: minBond - 1})
+		require.ErrorIs(t, err, types.ErrBondTooLow)
+	})
+	t.Run("zero bond", func(t *testing.T) {
+		_, err := f.ms.RegisterProber(f.scratch(), &types.MsgRegisterProber{Owner: str})
+		require.ErrorIs(t, err, types.ErrBondTooLow)
+	})
+	t.Run("cannot pay", func(t *testing.T) {
+		_, poor := f.account(t, 9)
+		_, err := f.ms.RegisterProber(f.ctx, &types.MsgRegisterProber{Owner: poor, Bond: minBond})
+		require.ErrorIs(t, err, sdkerrors.ErrInsufficientFunds)
+		// Nothing was stored for the failed registration.
+		has, err := f.keeper.ProberByOwner.Has(f.ctx, poor)
+		require.NoError(t, err)
+		require.False(t, has)
+		requireInt(t, 0, f.moduleBalance())
+	})
+	t.Run("second prober for the same address", func(t *testing.T) {
+		_, err := f.ms.RegisterProber(f.ctx, &types.MsgRegisterProber{Owner: str, Bond: minBond})
+		require.NoError(t, err)
+		_, err = f.ms.RegisterProber(f.scratch(), &types.MsgRegisterProber{Owner: str, Bond: minBond})
+		require.ErrorIs(t, err, types.ErrAlreadyProber)
+		// Only one bond was taken.
+		requireInt(t, minBond, f.moduleBalance())
+		f.requireBondsExact(t)
+	})
+}
+
+func TestBondAboveMinimumIsKeptWhole(t *testing.T) {
+	f := initFixture(t)
+	addr, str := f.account(t, 1)
+	f.fund(addr, minBond*2)
+	res, err := f.ms.RegisterProber(f.ctx, &types.MsgRegisterProber{Owner: str, Bond: minBond * 2})
+	require.NoError(t, err)
+	require.Equal(t, minBond*2, f.prober(t, res.Id).Bond)
+	requireInt(t, 0, f.balance(addr))
+	f.requireBondsExact(t)
+}
+
+// A prober joins the active set only when a round starts, never mid-round.
+func TestProberJoinsAtRoundStart(t *testing.T) {
+	f := initFixture(t)
+	f.begin(t) // round 1 starts with nobody
+	require.Equal(t, uint64(1), f.round(t))
+
+	p := f.newProber(t, 1)
+	f.nextBlocks(t, testRoundBlocks-1) // still round 1
+	require.Equal(t, uint64(1), f.round(t))
+	require.Equal(t, types.ProberPending, f.prober(t, p.id).Status)
+	f.requireActiveConsistent(t)
+
+	f.nextBlocks(t, 1) // round 2 starts
+	require.Equal(t, uint64(2), f.round(t))
+	require.Equal(t, types.ProberActive, f.prober(t, p.id).Status)
+	waiting, err := f.keeper.PendingJoin.Has(f.ctx, p.id)
+	require.NoError(t, err)
+	require.False(t, waiting)
+	require.True(t, f.hasEvent("verify_prober_joined"))
+	f.requireActiveConsistent(t)
+}
+
+// A prober that has not joined yet can leave at once.
+func TestDeregisterPendingProber(t *testing.T) {
+	f := initFixture(t)
+	f.begin(t)
+	p := f.newProber(t, 1)
+
+	_, err := f.ms.DeregisterProber(f.ctx, &types.MsgDeregisterProber{Owner: p.str})
+	require.NoError(t, err)
+	got := f.prober(t, p.id)
+	require.Equal(t, types.ProberUnbonding, got.Status)
+	require.Equal(t, f.sdkCtx.BlockTime().Unix()+int64(types.DefaultUnbondingSeconds), got.UnbondingEnd)
+
+	// It never joins the active set.
+	f.nextRound(t)
+	require.Equal(t, types.ProberUnbonding, f.prober(t, p.id).Status)
+	f.requireActiveConsistent(t)
+
+	// The bond is locked for the whole unbonding period.
+	_, err = f.ms.WithdrawProberBond(f.scratch(), &types.MsgWithdrawProberBond{Owner: p.str})
+	require.ErrorIs(t, err, types.ErrUnbondingNotOver)
+	f.requireBondsExact(t)
+}
+
+// An active prober stays assignable until the next round starts.
+func TestDeregisterActiveProber(t *testing.T) {
+	w := newWorld(t)
+	p := w.p[1]
+
+	_, err := w.ms.DeregisterProber(w.ctx, &types.MsgDeregisterProber{Owner: p.str})
+	require.NoError(t, err)
+	require.Equal(t, types.ProberLeaving, w.prober(t, p.id).Status)
+	w.requireActiveConsistent(t) // still in the list
+
+	// It can still report in the round it is leaving.
+	w.commit(t, p, 1, 1, types.ResultPass, 0)
+
+	// Asking twice is refused.
+	_, err = w.ms.DeregisterProber(w.scratch(), &types.MsgDeregisterProber{Owner: p.str})
+	require.ErrorIs(t, err, types.ErrProberLeaving)
+
+	// Even with the unbonding time over, the bond stays locked while the
+	// prober is still in the active set.
+	w.advanceTime(unbonding + time.Hour)
+	_, err = w.ms.WithdrawProberBond(w.scratch(), &types.MsgWithdrawProberBond{Owner: p.str})
+	require.ErrorIs(t, err, types.ErrProberNotUnbonding)
+
+	w.nextRound(t)
+	require.Equal(t, types.ProberUnbonding, w.prober(t, p.id).Status)
+	require.True(t, w.hasEvent("verify_prober_left"))
+	w.requireActiveConsistent(t)
+	count, err := w.keeper.ActiveCount.Get(w.ctx)
+	require.NoError(t, err)
+	require.Equal(t, uint64(2), count)
+
+	// Out of the active set, it can no longer seal reports.
+	_, err = w.ms.CommitReports(w.scratch(), &types.MsgCommitReports{
+		Owner: p.str, Round: 2, NodeIds: []uint64{2}, Hashes: []string{seal(2, 2, p.id, types.ResultPass, 0)},
+	})
+	require.ErrorIs(t, err, types.ErrProberNotActive)
+
+	// But it can still open what it sealed before leaving.
+	w.reveal(t, p, 1, 1, types.ResultPass, 0)
+}
+
+func TestWithdrawProberBond(t *testing.T) {
+	w := newWorld(t)
+	p := w.p[0]
+
+	t.Run("active prober cannot withdraw", func(t *testing.T) {
+		_, err := w.ms.WithdrawProberBond(w.scratch(), &types.MsgWithdrawProberBond{Owner: p.str})
+		require.ErrorIs(t, err, types.ErrProberNotUnbonding)
+	})
+	t.Run("unknown address", func(t *testing.T) {
+		_, stranger := w.account(t, 0x77)
+		_, err := w.ms.WithdrawProberBond(w.scratch(), &types.MsgWithdrawProberBond{Owner: stranger})
+		require.ErrorIs(t, err, types.ErrProberNotFound)
+		_, err = w.ms.DeregisterProber(w.scratch(), &types.MsgDeregisterProber{Owner: stranger})
+		require.ErrorIs(t, err, types.ErrProberNotFound)
+	})
+
+	_, err := w.ms.DeregisterProber(w.ctx, &types.MsgDeregisterProber{Owner: p.str})
+	require.NoError(t, err)
+	w.nextRound(t)
+
+	t.Run("one second early", func(t *testing.T) {
+		end := w.prober(t, p.id).UnbondingEnd
+		w.advanceTime(time.Duration(end-w.sdkCtx.BlockTime().Unix()-1) * time.Second)
+		_, err := w.ms.WithdrawProberBond(w.scratch(), &types.MsgWithdrawProberBond{Owner: p.str})
+		require.ErrorIs(t, err, types.ErrUnbondingNotOver)
+	})
+	t.Run("at the end", func(t *testing.T) {
+		w.advanceTime(time.Second)
+		_, err := w.ms.WithdrawProberBond(w.ctx, &types.MsgWithdrawProberBond{Owner: p.str})
+		require.NoError(t, err)
+
+		requireInt(t, minBond, w.balance(p.addr))
+		requireInt(t, minBond*2, w.moduleBalance())
+		w.requireBondsExact(t)
+
+		// The records are gone.
+		has, err := w.keeper.Prober.Has(w.ctx, p.id)
+		require.NoError(t, err)
+		require.False(t, has)
+		has, err = w.keeper.ProberByOwner.Has(w.ctx, p.str)
+		require.NoError(t, err)
+		require.False(t, has)
+	})
+	t.Run("cannot withdraw twice", func(t *testing.T) {
+		_, err := w.ms.WithdrawProberBond(w.scratch(), &types.MsgWithdrawProberBond{Owner: p.str})
+		require.ErrorIs(t, err, types.ErrProberNotFound)
+	})
+	t.Run("the address can register again", func(t *testing.T) {
+		res, err := w.ms.RegisterProber(w.ctx, &types.MsgRegisterProber{Owner: p.str, Bond: minBond})
+		require.NoError(t, err)
+		require.NotEqual(t, p.id, res.Id, "ids are never reused")
+		w.requireBondsExact(t)
+	})
+}
+
+// The unbonding end is fixed when the prober asks to leave. A later change
+// to the parameter must not move it.
+func TestUnbondingPeriodIsFixedAtDeregister(t *testing.T) {
+	w := newWorld(t)
+	p := w.p[0]
+	_, err := w.ms.DeregisterProber(w.ctx, &types.MsgDeregisterProber{Owner: p.str})
+	require.NoError(t, err)
+	end := w.prober(t, p.id).UnbondingEnd
+
+	w.setParams(t, func(p *types.Params) { p.UnbondingSeconds = 60 })
+	w.nextRound(t)
+	require.Equal(t, end, w.prober(t, p.id).UnbondingEnd)
+
+	w.advanceTime(time.Hour)
+	_, err = w.ms.WithdrawProberBond(w.scratch(), &types.MsgWithdrawProberBond{Owner: p.str})
+	require.ErrorIs(t, err, types.ErrUnbondingNotOver)
+}
+
+// Removing a prober from the middle of the active list must leave the list
+// dense and the index correct, whichever prober leaves.
+func TestActiveListStaysDense(t *testing.T) {
+	for leaver := 0; leaver < 5; leaver++ {
+		f := initFixture(t)
+		var ps []*tester
+		for i := 0; i < 5; i++ {
+			ps = append(ps, f.newProber(t, byte(0x20+i)))
+		}
+		f.begin(t)
+		f.requireActiveConsistent(t)
+
+		_, err := f.ms.DeregisterProber(f.ctx, &types.MsgDeregisterProber{Owner: ps[leaver].str})
+		require.NoError(t, err)
+		f.nextRound(t)
+		f.requireActiveConsistent(t)
+
+		count, err := f.keeper.ActiveCount.Get(f.ctx)
+		require.NoError(t, err)
+		require.Equal(t, uint64(4), count)
+	}
+}
+
+// Probers joining and leaving in the same round start are both applied.
+func TestJoinAndLeaveTogether(t *testing.T) {
+	w := newWorld(t)
+	_, err := w.ms.DeregisterProber(w.ctx, &types.MsgDeregisterProber{Owner: w.p[0].str})
+	require.NoError(t, err)
+	_, err = w.ms.DeregisterProber(w.ctx, &types.MsgDeregisterProber{Owner: w.p[2].str})
+	require.NoError(t, err)
+	a := w.newProber(t, 0x41)
+	b := w.newProber(t, 0x42)
+
+	w.nextRound(t)
+	w.requireActiveConsistent(t)
+	require.Equal(t, types.ProberActive, w.prober(t, a.id).Status)
+	require.Equal(t, types.ProberActive, w.prober(t, b.id).Status)
+	require.Equal(t, types.ProberUnbonding, w.prober(t, w.p[0].id).Status)
+	require.Equal(t, types.ProberActive, w.prober(t, w.p[1].id).Status)
+	count, err := w.keeper.ActiveCount.Get(w.ctx)
+	require.NoError(t, err)
+	require.Equal(t, uint64(3), count)
+	w.requireBondsExact(t)
+}
+
+func TestUnjailIsNotAvailableYet(t *testing.T) {
+	f := initFixture(t)
+	_, str := f.account(t, 1)
+	_, err := f.ms.Unjail(f.ctx, &types.MsgUnjail{Operator: str, NodeId: 1})
+	require.ErrorIs(t, err, types.ErrJailingNotAvailable)
+	_, err = f.ms.Unjail(f.ctx, &types.MsgUnjail{Operator: "bad", NodeId: 1})
+	require.Error(t, err)
+}
diff --git a/x/verify/keeper/query_round.go b/x/verify/keeper/query_round.go
new file mode 100644
index 0000000..71f2d80
--- /dev/null
+++ b/x/verify/keeper/query_round.go
@@ -0,0 +1,107 @@
+package keeper
+
+import (
+	"context"
+	"encoding/hex"
+	"errors"
+
+	"cosmossdk.io/collections"
+	sdkerrors "github.com/cosmos/cosmos-sdk/types/errors"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+
+	"github.com/mspvantage/smartnodes/x/verify/types"
+)
+
+// Round returns the current round, its seed and when the next one starts.
+// Prober software uses the seed to work out its own assignments.
+func (q queryServer) Round(ctx context.Context, req *types.QueryRoundRequest) (*types.QueryRoundResponse, error) {
+	if req == nil {
+		return nil, status.Error(codes.InvalidArgument, "invalid request")
+	}
+
+	round, start, err := q.k.CurrentRound(ctx)
+	if err != nil {
+		return nil, status.Error(codes.Internal, err.Error())
+	}
+	active, err := q.k.activeCount(ctx)
+	if err != nil {
+		return nil, status.Error(codes.Internal, err.Error())
+	}
+	res := &types.QueryRoundResponse{Round: round, StartHeight: start, ActiveProbers: active}
+	if round == 0 {
+		return res, nil
+	}
+
+	params, err := q.k.Params.Get(ctx)
+	if err != nil {
+		return nil, status.Error(codes.Internal, err.Error())
+	}
+	res.NextRoundHeight = start + int64(params.RoundBlocks)
+
+	seed, err := q.k.RoundSeed.Get(ctx, round)
+	if err != nil && !errors.Is(err, collections.ErrNotFound) {
+		return nil, status.Error(codes.Internal, err.Error())
+	}
+	res.Seed = hex.EncodeToString(seed)
+	return res, nil
+}
+
+// NodeRecord returns a node's verification record.
+func (q queryServer) NodeRecord(ctx context.Context, req *types.QueryNodeRecordRequest) (*types.QueryNodeRecordResponse, error) {
+	if req == nil {
+		return nil, status.Error(codes.InvalidArgument, "invalid request")
+	}
+
+	rec, err := q.k.NodeRecord.Get(ctx, req.NodeId)
+	if err != nil {
+		if errors.Is(err, collections.ErrNotFound) {
+			return nil, sdkerrors.ErrKeyNotFound
+		}
+		return nil, status.Error(codes.Internal, "internal error")
+	}
+	return &types.QueryNodeRecordResponse{NodeRecord: rec}, nil
+}
+
+// Assignment returns whether a node is probed in the current round and, if
+// so, which probers are assigned to it.
+func (q queryServer) Assignment(ctx context.Context, req *types.QueryAssignmentRequest) (*types.QueryAssignmentResponse, error) {
+	if req == nil {
+		return nil, status.Error(codes.InvalidArgument, "invalid request")
+	}
+
+	round, _, err := q.k.CurrentRound(ctx)
+	if err != nil {
+		return nil, status.Error(codes.Internal, err.Error())
+	}
+	res := &types.QueryAssignmentResponse{Round: round}
+	if round == 0 {
+		return res, nil
+	}
+
+	params, err := q.k.Params.Get(ctx)
+	if err != nil {
+		return nil, status.Error(codes.Internal, err.Error())
+	}
+	seed, err := q.k.RoundSeed.Get(ctx, round)
+	if err != nil {
+		return nil, status.Error(codes.Internal, err.Error())
+	}
+	if !types.Selected(seed, req.NodeId, params.SampleBps) {
+		return res, nil
+	}
+	res.Selected = true
+
+	active, err := q.k.activeCount(ctx)
+	if err != nil {
+		return nil, status.Error(codes.Internal, err.Error())
+	}
+	for _, idx := range types.AssignedIndices(seed, req.NodeId, active, params.ProbersPerNode) {
+		id, err := q.k.ActiveList.Get(ctx, idx)
+		if err != nil {
+			return nil, status.Error(codes.Internal, err.Error())
+		}
+		res.ProberIds = append(res.ProberIds, id)
+	}
+	return res, nil
+}
diff --git a/x/verify/keeper/round.go b/x/verify/keeper/round.go
new file mode 100644
index 0000000..bb1a50d
--- /dev/null
+++ b/x/verify/keeper/round.go
@@ -0,0 +1,366 @@
+package keeper
+
+import (
+	"context"
+	"encoding/binary"
+	"encoding/hex"
+	"errors"
+
+	"cosmossdk.io/collections"
+	sdk "github.com/cosmos/cosmos-sdk/types"
+
+	"github.com/mspvantage/smartnodes/x/verify/types"
+)
+
+const (
+	// MaxSetChangesPerRound bounds how many probers join, and how many
+	// leave, the active set when a round starts.
+	MaxSetChangesPerRound = 500
+	// MaxTallyReportsPerBlock bounds the reports tallied in one block. A
+	// round with more reports is tallied over several blocks.
+	MaxTallyReportsPerBlock = 300
+	// maxTallyOverrun lets the tally finish the node it is on after the
+	// bound is reached, so a node's reports are normally counted together.
+	maxTallyOverrun = 64
+	// SeedsKept is how many recent round seeds stay in the store.
+	SeedsKept = 3
+	// GasPerCommit is charged for each sealed report: one registry read, one
+	// assignment check and one write.
+	GasPerCommit = 5_000
+
+	reportValueLength = types.HashLength + 2
+)
+
+// reportKey builds the store key of a report.
+func reportKey(round, nodeID, proberID uint64) collections.Pair[uint64, []byte] {
+	suffix := make([]byte, 16)
+	binary.BigEndian.PutUint64(suffix[:8], nodeID)
+	binary.BigEndian.PutUint64(suffix[8:], proberID)
+	return collections.Join(round, suffix)
+}
+
+// splitReportKey returns the node and prober of a report key.
+func splitReportKey(key collections.Pair[uint64, []byte]) (nodeID, proberID uint64, ok bool) {
+	suffix := key.K2()
+	if len(suffix) != 16 {
+		return 0, 0, false
+	}
+	return binary.BigEndian.Uint64(suffix[:8]), binary.BigEndian.Uint64(suffix[8:]), true
+}
+
+// A stored report is the sealed hash, then one byte for the opened result
+// (0 while still sealed), then one byte for the speed band.
+func encodeReport(hash []byte, result, speedBand uint64) []byte {
+	out := make([]byte, 0, reportValueLength)
+	out = append(out, hash...)
+	return append(out, byte(result), byte(speedBand))
+}
+
+func decodeReport(value []byte) (hash []byte, result, speedBand uint64, ok bool) {
+	if len(value) != reportValueLength {
+		return nil, 0, 0, false
+	}
+	return value[:types.HashLength], uint64(value[types.HashLength]), uint64(value[types.HashLength+1]), true
+}
+
+// CurrentRound returns the current round number and the height it started
+// at. The round is 0 before the first block has been processed.
+func (k Keeper) CurrentRound(ctx context.Context) (round uint64, start int64, err error) {
+	round, err = k.RoundNumber.Get(ctx)
+	if err != nil {
+		if errors.Is(err, collections.ErrNotFound) {
+			return 0, 0, nil
+		}
+		return 0, 0, err
+	}
+	start, err = k.RoundStart.Get(ctx)
+	if err != nil {
+		if errors.Is(err, collections.ErrNotFound) {
+			return round, 0, nil
+		}
+		return 0, 0, err
+	}
+	return round, start, nil
+}
+
+// BeginBlocker starts a new round when one is due and tallies finished
+// rounds, a bounded number of reports per block.
+//
+// The work runs on a copy of the state. If anything fails, the copy is
+// discarded, an event records why, and the block carries on. A fault here
+// must never stop the chain.
+func (k Keeper) BeginBlocker(ctx context.Context) error {
+	sdkCtx := sdk.UnwrapSDKContext(ctx)
+
+	cacheCtx, write := sdkCtx.CacheContext()
+	if err := k.runBlock(cacheCtx); err != nil {
+		sdkCtx.Logger().Error("verify: begin block skipped", "error", err.Error())
+		sdkCtx.EventManager().EmitEvent(sdk.NewEvent(EventTypeBlockerFailed,
+			sdk.NewAttribute(AttributeKeyReason, err.Error()),
+		))
+		return nil
+	}
+	write()
+	return nil
+}
+
+func (k Keeper) runBlock(ctx sdk.Context) error {
+	params, err := k.Params.Get(ctx)
+	if err != nil {
+		return err
+	}
+	round, start, err := k.CurrentRound(ctx)
+	if err != nil {
+		return err
+	}
+
+	height := ctx.BlockHeight()
+	// Rounds are counted, not derived from the height, so changing the round
+	// length never makes the round number jump or go backwards.
+	if round == 0 || height >= start+int64(params.RoundBlocks) {
+		round++
+		if err := k.startRound(ctx, round); err != nil {
+			return err
+		}
+	}
+
+	return k.TallyDue(ctx, round, params)
+}
+
+// startRound fixes the seed and the active prober set for a new round.
+func (k Keeper) startRound(ctx sdk.Context, round uint64) error {
+	var prev []byte
+	if round > 1 {
+		seed, err := k.RoundSeed.Get(ctx, round-1)
+		if err != nil && !errors.Is(err, collections.ErrNotFound) {
+			return err
+		}
+		prev = seed
+	}
+	seed := types.NextSeed(prev, round, ctx.HeaderHash())
+	if err := k.RoundSeed.Set(ctx, round, seed); err != nil {
+		return err
+	}
+	if round > SeedsKept {
+		if err := k.RoundSeed.Remove(ctx, round-SeedsKept); err != nil {
+			return err
+		}
+	}
+	if err := k.RoundNumber.Set(ctx, round); err != nil {
+		return err
+	}
+	if err := k.RoundStart.Set(ctx, ctx.BlockHeight()); err != nil {
+		return err
+	}
+
+	if err := k.applySetChanges(ctx); err != nil {
+		return err
+	}
+	active, err := k.activeCount(ctx)
+	if err != nil {
+		return err
+	}
+
+	emit(ctx, EventTypeNewRound,
+		sdk.NewAttribute(AttributeKeyRound, u64(round)),
+		sdk.NewAttribute(AttributeKeySeed, hex.EncodeToString(seed)),
+		sdk.NewAttribute(AttributeKeyActive, u64(active)),
+	)
+	return nil
+}
+
+// tallyEntry is one stored report read back for the tally.
+type tallyEntry struct {
+	key      collections.Pair[uint64, []byte]
+	nodeID   uint64
+	proberID uint64
+	result   uint64
+}
+
+// TallyDue counts the reports of rounds whose reveal window has closed.
+// Reports of round r are sealed during r and opened during r+1, so they are
+// counted from round r+2 on. Counted reports are deleted.
+//
+// Reports are stored in order of round and then node, so the oldest round is
+// always first and one node's reports are read together.
+func (k Keeper) TallyDue(ctx context.Context, current uint64, params types.Params) error {
+	if current < 3 {
+		return nil
+	}
+	lastDue := current - 2
+
+	iter, err := k.Reports.Iterate(ctx, nil)
+	if err != nil {
+		return err
+	}
+	var entries []tallyEntry
+	for ; iter.Valid(); iter.Next() {
+		kv, err := iter.KeyValue()
+		if err != nil {
+			_ = iter.Close()
+			return err
+		}
+		round := kv.Key.K1()
+		if round > lastDue {
+			break
+		}
+		nodeID, proberID, ok := splitReportKey(kv.Key)
+		_, result, _, okValue := decodeReport(kv.Value)
+		if !ok || !okValue {
+			// A malformed entry cannot be counted. Drop it below, as a
+			// sealed report from prober 0 for node 0, so it cannot block
+			// the queue.
+			result = types.ResultSealed
+		}
+		if n := len(entries); n >= MaxTallyReportsPerBlock {
+			last := entries[n-1]
+			sameNode := last.key.K1() == round && last.nodeID == nodeID
+			if !sameNode || n >= MaxTallyReportsPerBlock+maxTallyOverrun {
+				break
+			}
+		}
+		entries = append(entries, tallyEntry{key: kv.Key, nodeID: nodeID, proberID: proberID, result: result})
+	}
+	if err := iter.Close(); err != nil {
+		return err
+	}
+
+	for from := 0; from < len(entries); {
+		to := from + 1
+		for to < len(entries) &&
+			entries[to].key.K1() == entries[from].key.K1() &&
+			entries[to].nodeID == entries[from].nodeID {
+			to++
+		}
+		if err := k.tallyNode(ctx, entries[from:to], params); err != nil {
+			return err
+		}
+		from = to
+	}
+	return nil
+}
+
+// tallyNode decides one node's outcome for one round, updates the node's
+// record and the probers' counts, and deletes the reports.
+func (k Keeper) tallyNode(ctx context.Context, group []tallyEntry, params types.Params) error {
+	round := group[0].key.K1()
+	nodeID := group[0].nodeID
+
+	var pass, fail, tamper, silent uint64
+	for _, e := range group {
+		switch e.result {
+		case types.ResultPass:
+			pass++
+		case types.ResultFail:
+			fail++
+		case types.ResultTamper:
+			tamper++
+		default:
+			silent++
+		}
+	}
+	outcome, tamperProven := types.Tally(pass, fail, tamper, params.ProbersPerNode)
+
+	for _, e := range group {
+		if err := k.Reports.Remove(ctx, e.key); err != nil {
+			return err
+		}
+		if err := k.scoreProber(ctx, e.proberID, e.result, outcome); err != nil {
+			return err
+		}
+	}
+
+	// A node that has left the registry keeps no record.
+	if _, err := k.registryKeeper.GetNode(ctx, nodeID); err != nil {
+		if err := k.NodeRecord.Remove(ctx, nodeID); err != nil {
+			return err
+		}
+		return nil
+	}
+
+	rec, err := k.NodeRecord.Get(ctx, nodeID)
+	if err != nil {
+		if !errors.Is(err, collections.ErrNotFound) {
+			return err
+		}
+		rec = types.NodeRecord{NodeId: nodeID}
+	}
+	rec.LastRound = round
+	switch outcome {
+	case types.OutcomePass:
+		rec.Verified = true
+		rec.LastPassRound = round
+		rec.ConsecutiveFails = 0
+		rec.Passes++
+	case types.OutcomeFail:
+		rec.Verified = false
+		rec.ConsecutiveFails++
+		rec.Fails++
+	default:
+		// Not enough agreeing reports to decide. The node is not verified
+		// for this round, but this is not counted against it.
+		rec.Verified = false
+	}
+	if tamperProven {
+		rec.TamperRounds++
+	}
+	if err := k.NodeRecord.Set(ctx, nodeID, rec); err != nil {
+		return err
+	}
+
+	emit(ctx, EventTypeTally,
+		sdk.NewAttribute(AttributeKeyRound, u64(round)),
+		sdk.NewAttribute(AttributeKeyNodeID, u64(nodeID)),
+		sdk.NewAttribute(AttributeKeyOutcome, outcome),
+		sdk.NewAttribute(AttributeKeyPass, u64(pass)),
+		sdk.NewAttribute(AttributeKeyFail, u64(fail)),
+		sdk.NewAttribute(AttributeKeyTamper, u64(tamper)),
+		sdk.NewAttribute(AttributeKeySilent, u64(silent)),
+	)
+	// This version only reports. The event marks where jailing would happen
+	// once penalties are switched on.
+	if outcome == types.OutcomeFail && rec.ConsecutiveFails >= params.FailsBeforeJail {
+		emit(ctx, EventTypeWouldJail,
+			sdk.NewAttribute(AttributeKeyNodeID, u64(nodeID)),
+			sdk.NewAttribute(AttributeKeyFails, u64(rec.ConsecutiveFails)),
+		)
+	}
+	return nil
+}
+
+// scoreProber records whether a prober's report agreed with the outcome.
+//
+//   - A sealed report that was never opened counts against the prober.
+//   - If the node's outcome was decided, an opened report counts for the
+//     prober when it agrees and against it when it does not.
+//   - If the outcome was not decided, opened reports are not scored.
+func (k Keeper) scoreProber(ctx context.Context, proberID, result uint64, outcome string) error {
+	var accepted, outlier bool
+	switch {
+	case !types.ValidResult(result):
+		outlier = true
+	case outcome == types.OutcomePass:
+		accepted = result == types.ResultPass
+		outlier = !accepted
+	case outcome == types.OutcomeFail:
+		accepted = result == types.ResultFail || result == types.ResultTamper
+		outlier = !accepted
+	}
+	if !accepted && !outlier {
+		return nil
+	}
+
+	prober, err := k.Prober.Get(ctx, proberID)
+	if err != nil {
+		if errors.Is(err, collections.ErrNotFound) {
+			return nil
+		}
+		return err
+	}
+	if accepted {
+		prober.Accepted++
+	} else {
+		prober.Outliers++
+	}
+	return k.Prober.Set(ctx, proberID, prober)
+}
